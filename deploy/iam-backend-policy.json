{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDbPasswordOnly",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/coupon/prod/db_password"
    },
    {
      "Sid": "DecryptWithAwsManagedSsmKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com" }
      }
    }
  ]
}
