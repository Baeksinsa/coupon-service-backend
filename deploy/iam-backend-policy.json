{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppDbSecretOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-northeast-2:<ACCOUNT_ID>:secret:coupon/prod/app-db-??????"
    },
    {
      "Sid": "InitDbReadMasterSecretTemporary",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "<RDS_MASTER_SECRET_ARN>"
    }
  ]
}
