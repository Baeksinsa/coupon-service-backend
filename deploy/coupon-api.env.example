# /etc/coupon-api.env  (chmod 600, owner root)
# 이 파일에 평문 비밀번호를 넣지 않는다. DB_PASSWORD_SECRET_ID 로 Secrets Manager 에서 읽는다.
# RDS 엔드포인트로 교체
DB_HOST=CHANGE_ME_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=coupondb
DB_USER=coupon
# 앱 전용 계정 시크릿 (JSON {"username","password"} 또는 평문). 마스터 시크릿을 쓰지 않는다.
DB_PASSWORD_SECRET_ID=coupon/prod/app-db
DB_SSLMODE=require
DB_POOL_MIN=2
DB_POOL_MAX=10

# ElastiCache 전송 중 암호화(TLS) 사용 → rediss:// (인증서는 시스템 CA 로 검증)
# ElastiCache Primary 엔드포인트로 교체
REDIS_URL=rediss://CHANGE_ME_REDIS_ENDPOINT:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=4

AWS_REGION=ap-northeast-2
# 백엔드마다 다르게: backend-a / backend-b  (응답 헤더 X-Served-By 로 분산 확인)
INSTANCE_ID=backend-a
LOG_LEVEL=INFO
# 테스트 기간에만 설정. 비우면 /api/ops/* 가 404 로 닫힌다.
ADMIN_TOKEN=
