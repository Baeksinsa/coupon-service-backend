# --- RDS PostgreSQL ---
DB_HOST=coupon-db.xxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=coupon
DB_USER=coupon
# 운영은 DB_PASSWORD 대신 DB_PASSWORD_PARAM(SSM SecureString)을 쓴다
# DB_PASSWORD=localdevonly
DB_PASSWORD_PARAM=/coupon/prod/db_password
DB_SSLMODE=require
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- ElastiCache Valkey/Redis ---
# TLS 활성화 시 rediss:// 로 바꾼다 (PRD 12: 캐시 TLS 결정 사항)
REDIS_URL=redis://coupon-cache.xxxxxx.apn2.cache.amazonaws.com:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=4
REDIS_TIMEOUT_SECONDS=0.2

# --- 운영 ---
AWS_REGION=ap-northeast-2
INSTANCE_ID=backend-a
LOG_LEVEL=INFO
ADMIN_TOKEN=change-me-for-test-only
